[sub_resource type="Resource" id="tr_a"]
script = ExtResource("s_trig")
id = "hint_a_move_jump"
platform_id = "prologue_exit_table"
rect = Rect2(0, 0, 21, 6)
text = "이동: {move_left} {move_right}   점프: {jump}"
action = "jump"
beat = "a"

[sub_resource type="Resource" id="tr_b"]
script = ExtResource("s_trig")
id = "hint_b_stomp"
platform_id = "tut_t1"
rect = Rect2(0, 0, 5, 6)
text = "만두 밟기: 위에 착지, 또는 공중에서 {look_down}"
action = "look_down"
beat = "b"

[sub_resource type="Resource" id="tr_c1"]
script = ExtResource("s_trig")
id = "hint_c_bounce"
platform_id = "tut_t2"
rect = Rect2(0, 0, 5, 6)
text = "단무지 위에 착지하면 높이 튕겨 오름"
action = "jump"
beat = "c"
grants_skill = "roll"
toast = "새 기술: 구르기 ({roll})"

[sub_resource type="Resource" id="tr_c2"]
script = ExtResource("s_trig")
id = "hint_c_roll"
platform_id = "tut_t3"
rect = Rect2(0, 0, 5, 6)
text = "구르기 {roll}: 단무지가 쓰러져 발판이 됨"
action = "roll"
beat = "c"

[sub_resource type="Resource" id="tr_d"]
script = ExtResource("s_trig")
id = "hint_d_slam"
platform_id = "tut_t4"
rect = Rect2(0, 0, 4, 6)
text = "내려찍기: 공중에서 {roll}"
action = "roll"
beat = "d"
grants_skill = "slam"
toast = "새 기술: 내려찍기 (공중에서 {roll})"

[sub_resource type="Resource" id="tr_e"]
script = ExtResource("s_trig")
id = "hint_e_exit"
platform_id = "tut_t4"
rect = Rect2(5.5, 0, 3, 6)
text = "건너편으로 점프: {jump}"
action = "jump"
beat = "e"

[sub_resource type="Resource" id="sec_prologue"]
script = ExtResource("s_section")
id = "prologue"
external = true

[sub_resource type="Resource" id="sec_tutorial"]
script = ExtResource("s_section")
id = "tutorial"
platforms = Array[ExtResource("s_plat")]([SubResource("plat_prologue_exit_table"), SubResource("plat_tut_t1"), SubResource("plat_tut_t2"), SubResource("plat_tut_ledge1"), SubResource("plat_tut_t3"), SubResource("plat_tut_ledge2"), SubResource("plat_tut_t4")])
spawns = Array[ExtResource("s_spawn")]([SubResource("sp_b"), SubResource("sp_c1"), SubResource("sp_c2"), SubResource("sp_d1"), SubResource("sp_d2"), SubResource("sp_d3")])
checkpoints = Array[ExtResource("s_cp")]([SubResource("cp_tut")])
triggers = Array[ExtResource("s_trig")]([SubResource("tr_a"), SubResource("tr_b"), SubResource("tr_c1"), SubResource("tr_c2"), SubResource("tr_d"), SubResource("tr_e")])
skip_grants = PackedStringArray("roll", "slam")
skip_source = "tutorial"
skip_toast = "새 기술: 구르기 ({roll}) · 내려찍기 (공중에서 {roll})"
skip_to_checkpoint = "map01_dining_start"

[sub_resource type="Resource" id="sec_dining"]
script = ExtResource("s_section")
id = "dining_room_start"
platforms = Array[ExtResource("s_plat")]([SubResource("plat_dining_1"), SubResource("plat_dining_2"), SubResource("plat_dining_3")])
spawns = Array[ExtResource("s_spawn")]([SubResource("sp_dining")])
checkpoints = Array[ExtResource("s_cp")]([SubResource("cp_din")])

