; The second way up to the first ledge: a napkin box against its wall. Too high to jump onto
; (rise_basis "platform"), it is a step from a knocked-over wheel lying next to it, and from its top the
; ledge is a plain jump. The bounce is the first way (hint c1), the roll the second (hint c2).
[sub_resource type="Resource" id="plat_tut_box"]
script = ExtResource("s_plat")
id = "tut_box"
kind = "prop"
