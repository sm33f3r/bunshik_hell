; ---------------------------------------------------------------------------------------------------
; Task 3c-i-a: the kitchen front. It goes on from the last dining table (the dining room's end wall is
; gone): two more tables over a floor lane that runs on to the open kitchen doorway, a 정수기 in front of
; the doorway, a short kitchen stub beyond it and a temporary end wall (the kitchen is built in 3c-ii).
; Distances (🟡), each measured with from_id: the 정수기's spout 20 m past the last chair step, the doorway's
; near edge 8 m past the spout (3 m wide, so its middle is 9.5 m past), ramen_start_1 4 m past the spout. Between the stairs and the doorway: open floor.
; The 간장 bottle has two candidate spots, under the last table; one is picked per new game.
; ---------------------------------------------------------------------------------------------------

[sub_resource type="Resource" id="plat_kf_t1"]
script = ExtResource("s_plat")
id = "kf_t1"
kind = "table"
length_cm = 70
gap_fraction = 0.6
color = Color(0.541, 0.561, 0.416, 1)

; The last dining table. The bottle stands on the floor under it.
[sub_resource type="Resource" id="plat_kf_t2"]
script = ExtResource("s_plat")
id = "kf_t2"
kind = "table"
length_cm = 80
gap_fraction = 0.6
color = Color(0.604, 0.627, 0.439, 1)

[sub_resource type="Resource" id="plat_chair_kf_t2"]
script = ExtResource("s_plat")
id = "chair_kf_t2"
kind = "stairs"
length_cm = 14
host = "kf_t2"
along_cm = 0.5
chain = false
main_path = false
color = Color(0.450, 0.330, 0.220, 1)
steps = 9
side = "right"
top_drop_cm = 9.0
bottom_rise_cm = 8.0
thickness_cm = 2

; The floor lane goes on from the dining room's (it starts under the last dining-room table, so the two
; overlap) under the new tables, past the chair steps, to the kitchen doorway and the stub beyond it.
[sub_resource type="Resource" id="plat_kitchen_floor"]
script = ExtResource("s_plat")
id = "kitchen_floor"
kind = "floor"
length_cm = 100
thickness_cm = 30
chain = false
main_path = false
color = Color(0.300, 0.260, 0.240, 1)
span_from = "r_t15"
span_to = "kf_t2"
drop_from = "prologue_exit_table"
drop_cm = 75.0
span_extra_right_cm = 375.0

; Under the last table (13.96 m long), clear of its legs (behind the lane) and of the chair steps.
[sub_resource type="Resource" id="spot_under_left"]
script = ExtResource("s_cand")
id = "under_last_table_left"
platform_id = "kitchen_floor"
from_id = "kf_t2"
along_m = -12.0

[sub_resource type="Resource" id="spot_under_right"]
script = ExtResource("s_cand")
id = "under_last_table_right"
platform_id = "kitchen_floor"
from_id = "kf_t2"
along_m = -2.0

; The 간장 bottle: the 나트륨 source for the 라면 of Task 3c-i-b, so it is required_for_progress (it comes
; back upright with all its squirts at every life, and when it has fallen off its table).
[sub_resource type="Resource" id="sp_bottle"]
script = ExtResource("s_spawn")
scene = ExtResource("sc_bottle")
group = "bottle"
required_for_progress = true
respawn_delay_s = 4.0
out_below_m = 1.5
choice_id = "ganjang_bottle"
candidates = Array[ExtResource("s_cand")]([SubResource("spot_under_left"), SubResource("spot_under_right")])
choice_width_cm = 3.5
choice_height_cm = 8.0

[sub_resource type="Resource" id="cp_kitchen"]
script = ExtResource("s_cp")
id = "kitchen_front_start"
platform_id = "kf_t1"
along_m = 2.0
lift_m = 0.5

[sub_resource type="Resource" id="fx_dispenser"]
script = ExtResource("s_fix")
id = "water_dispenser_1"
kind = "water_dispenser"
platform_id = "kitchen_floor"
from_id = "chair_kf_t2_9"
along_m = 20.0
width_cm = 25.0
height_cm = 30.0
mount_cm = 18.0
params = {"pour_zone_width_m": 2.0, "sodium_cost": 1}

[sub_resource type="Resource" id="door_kitchen"]
script = ExtResource("s_door")
id = "kitchen_door"
platform_id = "kitchen_floor"
from_id = "water_dispenser_1"
along_m = 9.5
width_cm = 17.2
height_cm = 18.0
bottom_edge_cm = 1.5
strips = 9
strip_fill = 0.7
strip_z_near_m = 0.5
strip_z_far_m = 0.7
frame_thickness_cm = 2.0
frame_clearance_m = 0.4
wall_gap_cm = 9.0
wall_height_cm = 70.0
wall_before_cm = 160.0

; Where the first 라면 will stand (Task 3c-i-b). Data only.
[sub_resource type="Resource" id="mark_ramen_1"]
script = ExtResource("s_mark")
id = "ramen_start_1"
platform_id = "kitchen_floor"
from_id = "water_dispenser_1"
along_m = 4.0

[sub_resource type="Resource" id="sec_kitchen_front"]
script = ExtResource("s_section")
id = "kitchen_front"
platforms = Array[ExtResource("s_plat")]([SubResource("plat_kf_t1"), SubResource("plat_kf_t2"), SubResource("plat_kitchen_floor"), SubResource("plat_chair_kf_t2")])
spawns = Array[ExtResource("s_spawn")]([SubResource("sp_bottle")])
checkpoints = Array[ExtResource("s_cp")]([SubResource("cp_kitchen")])
fixtures = Array[ExtResource("s_fix")]([SubResource("fx_dispenser")])
doorways = Array[ExtResource("s_door")]([SubResource("door_kitchen")])
markers = Array[ExtResource("s_mark")]([SubResource("mark_ramen_1")])
end_wall_text = "[dev] Map 1 continues here (Task 3c-ii: the kitchen)"
end_wall_after = "kitchen_floor"

[resource]
script = ExtResource("s_layout")
sections = Array[ExtResource("s_section")]([SubResource("sec_prologue"), SubResource("sec_tutorial"), SubResource("sec_dining"), SubResource("sec_dining_room"), SubResource("sec_kitchen_front")])
prompt_accept_text = "튜토리얼 하기"
prompt_cancel_text = "건너뛰기"
fade_out_s = 0.35
fade_in_s = 0.35
fall_depth_m = 4.0
headroom_m = 0.9
climb_spacing_max_m = 60.0
spout_clearance_m = 10.0
