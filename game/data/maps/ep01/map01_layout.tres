[sub_resource type="Resource" id="sp_b"]
script = ExtResource("s_spawn")
platform_id = "tut_t1"
scene = ExtResource("sc_mandu")
along_m = 6.0
size_cm = 5.0
group = "b"

[sub_resource type="Resource" id="sp_c1"]
script = ExtResource("s_spawn")
platform_id = "tut_t2"
scene = ExtResource("sc_danmuji")
along_m = 5.0
start_dir = -1.0
group = "c1"

[sub_resource type="Resource" id="sp_c2"]
script = ExtResource("s_spawn")
platform_id = "tut_t3"
scene = ExtResource("sc_danmuji")
along_m = 5.0
group = "c2"

[sub_resource type="Resource" id="sp_d1"]
script = ExtResource("s_spawn")
platform_id = "tut_t4"
scene = ExtResource("sc_mandu")
along_m = 3.0
size_cm = 5.0
params = {"speed_scale": 0.0}
group = "d"

[sub_resource type="Resource" id="sp_d2"]
script = ExtResource("s_spawn")
platform_id = "tut_t4"
