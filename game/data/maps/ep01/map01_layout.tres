[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://maps/layout/map_layout.gd" id="s_layout"]
[ext_resource type="Script" path="res://maps/layout/map_section.gd" id="s_section"]
[ext_resource type="Script" path="res://maps/layout/platform_def.gd" id="s_plat"]
[ext_resource type="Script" path="res://maps/layout/spawn_entry.gd" id="s_spawn"]
[ext_resource type="Script" path="res://maps/layout/checkpoint_def.gd" id="s_cp"]
[ext_resource type="Script" path="res://maps/layout/prompt_trigger.gd" id="s_trig"]
[ext_resource type="PackedScene" path="res://enemies/mandu.tscn" id="sc_mandu"]
[ext_resource type="PackedScene" path="res://enemies/danmuji.tscn" id="sc_danmuji"]

